migrate_working_dir/

# IntelliJ / VS Code (local editor settings)
*.iml
*.ipr
*.iws
.idea/
.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android build outputs
android/.gradle/
android/build/
**/local.properties

# Secrets / env (never commit)
.env
.env.*
!.env.example

# Feedback Related (never commit — local only)
# Includes feedback/images/ screenshots and feedback/inbox/ notes.
feedback/

# Friend fixture install queue (local maintainer tooling)
tool/.friend_install_queue.json
tool/.friend_install_queue.json.installed

# Local friend APK drops and any APK/AAB binaries
friend_share/
*.apk
*.aab

# Bro Code fixture captures (local + pull tool). Keep the folder in git;
# ignore captured bundles/screenshots so they stay local unless explicitly forced.
test/fixtures/bro_code/**
!test/fixtures/bro_code/.gitkeep
!test/fixtures/bro_code/README.md


# One-off scratch scripts / snippets at repo root
/_acts.txt
/_html_snip.txt
/patch.dart
/patch.py
/patch2.dart
/search.dart
/test_quickjs.dart

# Vendored plugin build caches (must never be committed)
third_party/**/.cxx/
third_party/**/.gradle/
third_party/**/build/
